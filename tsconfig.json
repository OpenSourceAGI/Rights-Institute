{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@rights/animations/*": [
        "./packages/animations/src/*"
      ],
      "@rights/auth": [
        "./packages/auth/src/index.ts"
      ],
      "@rights/auth/*": [
        "./packages/auth/src/*"
      ],
      "@rights/cause": [
        "./packages/cause/src/index.ts"
      ],
      "@rights/cause/*": [
        "./packages/cause/src/*"
      ],
      "@rights/contract-builder/*": [
        "./packages/contract-builder/src/*"
      ],
      "@rights/credit": [
        "./packages/credit/src/index.ts"
      ],
      "@rights/credit/*": [
        "./packages/credit/src/*"
      ],
      "@rights/db": [
        "./packages/db/src/index.ts"
      ],
      "@rights/db/*": [
        "./packages/db/src/*"
      ],
      "@rights/env": [
        "./packages/env/src/index.ts"
      ],
      "@rights/env/*": [
        "./packages/env/src/*"
      ],
      "@rights/innovation-timeline": [
        "./packages/innovation-timeline/src/index.ts"
      ],
      "@rights/innovation-timeline/*": [
        "./packages/innovation-timeline/src/*"
      ],
      "@rights/investor-rank": [
        "./packages/investor-rank/src/index.ts"
      ],
      "@rights/investor-rank/*": [
        "./packages/investor-rank/src/*"
      ],
      "@rights/prosper-license/*": [
        "./packages/prosper-license/src/*"
      ],
      "@rights/site-shell/*": [
        "./packages/site-shell/src/*"
      ],
      "@rights/startup-tools": [
        "./packages/startup-tools/src/index.ts"
      ],
      "@rights/startup-tools/*": [
        "./packages/startup-tools/src/*"
      ],
      "@rights/terms-privacy": [
        "./packages/terms-privacy/src/index.ts"
      ],
      "@rights/terms-privacy/*": [
        "./packages/terms-privacy/src/*"
      ],
      "@rights/text-effects/*": [
        "./packages/text-effects/src/*"
      ],
      "@rights/ui/*": [
        "./packages/ui/src/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/*": [
        "./app/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/src/**/*.jsx",
    "next-env.d.ts",
    "out/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "docs-config/**",
    "**/node_modules/**"
  ]
}
